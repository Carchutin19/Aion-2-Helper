<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Ink" Color="#F3F7FF"/>
  <SolidColorBrush x:Key="Muted" Color="#BACCEC"/>
  <SolidColorBrush x:Key="Accent" Color="#91EDFF"/>
  <LinearGradientBrush x:Key="GlassButton" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#AA385486" Offset="0"/><GradientStop Color="#D123335D" Offset=".54"/><GradientStop Color="#AD3C3976" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="LitGlass" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FC569DE8" Offset="0"/><GradientStop Color="#F73968BF" Offset=".21"/><GradientStop Color="#F4254087" Offset=".66"/><GradientStop Color="#F73365B3" Offset=".87"/><GradientStop Color="#FF67BDF5" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#A1A7D6FF" Offset="0"/><GradientStop Color="#4A86B1FF" Offset=".5"/><GradientStop Color="#7FC5B3FF" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="QuietGlass" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#5888B1F4" Offset="0"/><GradientStop Color="#565069B0" Offset=".47"/><GradientStop Color="#6443418A" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="QuietEdge" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#47AFCFFF" Offset="0"/><GradientStop Color="#0789BCFF" Offset=".51"/><GradientStop Color="#2D9C9AEC" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="LitEdge" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#F2FCFF" Offset="0"/><GradientStop Color="#65D9FF" Offset=".36"/><GradientStop Color="#AAA9FF" Offset=".7"/><GradientStop Color="#D8FCFF" Offset="1"/>
  </LinearGradientBrush>
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Background" Value="{StaticResource GlassButton}"/>
    <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Border x:Name="Aura" CornerRadius="11" BorderBrush="#B069DFFF" BorderThickness="1.5" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect Color="#72D9FF" BlurRadius="13" ShadowDepth="0" Opacity=".95"/></Border.Effect>
          </Border>
          <Border x:Name="Shell" CornerRadius="10" Margin="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
          <Grid x:Name="Reflections" Margin="1" Visibility="Collapsed" IsHitTestVisible="False">
            <Border CornerRadius="10"><Border.Background>
              <RadialGradientBrush Center=".19,0" GradientOrigin=".19,0" RadiusX=".26" RadiusY=".50">
                <GradientStop Color="#BEEDFFFF" Offset="0"/><GradientStop Color="#4896ECFF" Offset=".33"/><GradientStop Color="#0096ECFF" Offset="1"/>
              </RadialGradientBrush>
            </Border.Background></Border>
            <Border CornerRadius="10"><Border.Background>
              <RadialGradientBrush Center=".82,1" GradientOrigin=".82,1" RadiusX=".29" RadiusY=".49">
                <GradientStop Color="#C1E6FDFF" Offset="0"/><GradientStop Color="#4C8BE6FF" Offset=".36"/><GradientStop Color="#008BE6FF" Offset="1"/>
              </RadialGradientBrush>
            </Border.Background></Border>
          </Grid>
          <Border x:Name="Glint" Margin="2" CornerRadius="9" IsHitTestVisible="False" Opacity="0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,.82" EndPoint=".74,.18">
                <LinearGradientBrush.RelativeTransform><TranslateTransform X="-1.25"/></LinearGradientBrush.RelativeTransform>
                <GradientStop Color="#008BE9FF" Offset=".05"/><GradientStop Color="#008BE9FF" Offset=".30"/>
                <GradientStop Color="#3097DFFF" Offset=".47"/><GradientStop Color="#78E2F8FF" Offset=".53"/>
                <GradientStop Color="#208BE9FF" Offset=".61"/><GradientStop Color="#008BE9FF" Offset=".83"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Background" Value="{StaticResource LitGlass}"><Setter TargetName="Aura" Property="Visibility" Value="Visible"/><Setter TargetName="Reflections" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource LitEdge}"/><Setter TargetName="Aura" Property="Visibility" Value="Visible"/></Trigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
              <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True"/>
              <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
            </MultiDataTrigger.Conditions>
            <MultiDataTrigger.EnterActions><BeginStoryboard Name="HoverSheen"><Storyboard>
              <DoubleAnimation Storyboard.TargetName="Glint" Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(TranslateTransform.X)" From="-1.25" To="1.25" Duration="0:0:0.58" FillBehavior="Stop"/>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Glint" Storyboard.TargetProperty="Opacity" Duration="0:0:0.58" FillBehavior="Stop">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/><LinearDoubleKeyFrame KeyTime="0:0:0.13" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:0.46" Value="1"/><LinearDoubleKeyFrame KeyTime="0:0:0.58" Value="0"/>
              </DoubleAnimationUsingKeyFrames>
            </Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
            <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="HoverSheen"/></MultiDataTrigger.ExitActions>
          </MultiDataTrigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource LitGlass}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="BorderBrush" Value="{StaticResource LitEdge}"/>
    <Setter Property="Padding" Value="16,11"/>
  </Style>
  <Style x:Key="LaunchButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Path Data="M0,0 L9,5 L0,10 Z" Fill="#D6F5FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SelectedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource LitGlass}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LitEdge}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource QuietGlass}"/>
    <Setter Property="BorderBrush" Value="{StaticResource QuietEdge}"/>
    <Setter Property="Foreground" Value="#DEEAFF"/>
  </Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource QuietGlass}"/>
    <Setter Property="BorderBrush" Value="{StaticResource QuietEdge}"/>
    <Setter Property="Foreground" Value="#DFE9FF"/>
    <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Image Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Width="19" Height="19" VerticalAlignment="Center" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SelectedNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
    <Setter Property="Background" Value="{StaticResource LitGlass}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LitEdge}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style x:Key="ComingSoonNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
    <Setter Property="Foreground" Value="#C8D6ED"/>
    <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Image Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Width="19" Height="19" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <StackPanel Grid.Column="1" Margin="0,1,0,1">
          <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"/>
          <Border Background="#324F6EAB" BorderBrush="#697EACD8" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left">
            <TextBlock Text="{Binding ToolTip, RelativeSource={RelativeSource AncestorType=Button}}" Foreground="#C5DDFB" FontSize="10" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Grid>
    </DataTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="CheckBox">
        <Grid Width="42" Height="24">
          <Border x:Name="Rail" CornerRadius="12" Background="#FF2F416C" BorderThickness="1" BorderBrush="#8B7CA3D9"/>
          <Ellipse x:Name="Knob" Width="18" Height="18" Fill="#F4F5F7" HorizontalAlignment="Left" Margin="3"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Rail" Property="Background" Value="{StaticResource LitGlass}"/><Setter TargetName="Rail" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Rail" Property="BorderBrush" Value="White"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Item" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="3,2"><ContentPresenter/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#AA345F9B"/><Setter Property="Foreground" Value="#DAF7FF"/></Trigger>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#CA3E6AAB"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Background" Value="#DD1C2953"/>
    <Setter Property="BorderBrush" Value="#8D8CA8E2"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9"/>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><Path Data="M0,0 L4,4 L8,0" Stroke="#A7ADBA" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Grid></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="13,0,35,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
          <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="#FA202E56" CornerRadius="10" BorderBrush="#7097B6F2" BorderThickness="1" Padding="3" Margin="0,5,0,0"><ScrollViewer MaxHeight="240" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#58FFFFFF"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
    <Setter Property="Background" Value="#DD1C2953"/>
    <Setter Property="BorderBrush" Value="#8D8CA8E2"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="TextBox">
        <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
    <Setter Property="Height" Value="24"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Slider">
        <Grid Margin="0,3">
          <Border Background="#35FFFFFF" Height="3" CornerRadius="2"/>
          <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{StaticResource Accent}" Height="3" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="14" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Width="12" Height="12" Fill="#F2F4F7" Stroke="#40FFFFFF" StrokeThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" Height="18"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
          <Track.DecreaseRepeatButton><RepeatButton x:Name="PageDecrease" Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Pill" Width="3" MinHeight="24" CornerRadius="1.5" Background="#7097B6F2" Margin="0,2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="#65FFFFFF"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Pill" Property="Background" Value="#90FFFFFF"/></Trigger><DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal"><Setter TargetName="Pill" Property="Width" Value="Auto"/><Setter TargetName="Pill" Property="MinWidth" Value="24"/><Setter TargetName="Pill" Property="Height" Value="3"/><Setter TargetName="Pill" Property="MinHeight" Value="0"/><Setter TargetName="Pill" Property="Margin" Value="2,0"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton x:Name="PageIncrease" Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0"/></Track.IncreaseRepeatButton>
        </Track>
        <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="PageDecrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/><Setter TargetName="PageIncrease" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="SlimScroll" TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ScrollViewer">
        <Grid Background="{TemplateBinding Background}">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/></Grid.ColumnDefinitions>
          <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
          <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Style="{StaticResource {x:Type ScrollBar}}" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
        </Grid>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="ResizeGrip"><Setter Property="Opacity" Value="0.18"/></Style>
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/>
    <Setter Property="RowBackground" Value="#5420365D"/><Setter Property="AlternatingRowBackground" Value="#8B233664"/>
    <Setter Property="RowHeight" Value="32"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
  </Style>
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
      <StackPanel>
        <ToggleButton x:Name="HeaderToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left" Cursor="Hand">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" Padding="0,6"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Chevron" Text="›" Foreground="{StaticResource Accent}" Margin="0,0,8,0"/><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="⌄"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
          <ContentPresenter Content="{TemplateBinding Header}"/>
        </ToggleButton>
        <ContentPresenter x:Name="Details" Content="{TemplateBinding Content}" Visibility="Collapsed"/>
      </StackPanel>
      <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#F024365D"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,9"/><Setter Property="FontSize" Value="11"/>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,4"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="DataGridRow">
    <Setter Property="BorderThickness" Value="0"/>
    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#A2395B92"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#794479AB"/></Trigger></Style.Triggers>
  </Style>
</ResourceDictionary>
